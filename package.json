{
  "name": "testing",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
		"lint:eslint": "eslint --ext .js,.jsx,.ts,.tsx .",
		"fix:eslint": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
		"lint-tests:eslint": "cross-env eslint --ext .spec.js,.spec.jsx,.spec.ts,.spec.tsx,.test.js,.test.jsx,.test.ts,.test.tsx .",
		"fix-tests:eslint": "cross-env eslint --fix --ext .spec.js,.spec.jsx,.spec.ts,.spec.tsx,.test.js,.test.jsx,.test.ts,.test.tsx .",
		"playwright": "cross-env BASE_URL='https://playwright.dev/' npx playwright test",
		"codegen": "playwright codegen localhost:5380/",
		"playwright-test": "env-cmd playwright test",
		"test-h": "env-cmd playwright test --headed",
		"playwright-tests-AddNewPatient": "env-cmd playwright test AddNewPatient.test.mjs --headed",
		"playwright-tests-admin": "env-cmd playwright test playwrightTests/admin.test.mjs --headed",
		"playwright-tests-capture": "env-cmd playwright test playwrightTests/capture.test.mjs --headed",
		"playwright-tests-demo-mode": "env-cmd playwright test playwrightTests/demo-mode.test.mjs --headed",
		"playwright-tests-drugs": "env-cmd playwright test playwrightTests/drugs.test.mjs --headed",
		"playwright-tests-encounters": "env-cmd playwright test playwrightTests/encounters.test.mjs --headed",
		"playwright-tests-followup": "env-cmd playwright test followup.test.mjs --headed",
		"playwright-tests-Labs": "env-cmd playwright test Labs.test.mjs --headed",
		"playwright-tests-observations": "env-cmd playwright test observations.test.mjs --headed",
		"playwright-tests-reporting": "env-cmd playwright test reporting.test.mjs --headed",
		"playwright-tests-search": "env-cmd playwright test search.test.mjs --headed",
		"playwright-tests-EditUserPage": "env-cmd playwright test EditUserPage.test.mjs --headed",
		"playwright-tests-ChangePassword": "env-cmd playwright test ChangePassword.test.mjs --headed",
		"playwright-tests-DeletePatient": "env-cmd playwright test DeletePatient.test.mjs --headed",
    "playwright-tests-DeletePatientViaPatientAdmin": "env-cmd playwright test DeletePatientViaPatientAdmin.test.mjs --headed",
    "playwright-tests-DeleteUser": "env-cmd playwright test DeleteUser.test.mjs --headed",
    "playwright-tests-EditPatient": "env-cmd playwright test EditPatient.test.mjs --headed",
    "playwright-tests-Medicines": "env-cmd playwright test Medicines.test.mjs --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wc-phdc-hia/testing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wc-phdc-hia/testing/issues"
  },
  "homepage": "https://github.com/wc-phdc-hia/testing#readme",
  "devDependencies": {
    "@babel/eslint-parser": "^7.17.0",
    "@babel/preset-env": "^7.16.11",
    "@playwright/test": "^1.20.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.11.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "playwright": "^1.20.0",
    "prettier": "^2.6.0"
  }
}
